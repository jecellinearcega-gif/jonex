# ── Jonex Capability 启动配置 ──
CAPABILITY_KIND=atomic
CAPABILITY_NAME=openkb
SERVICE_PORT=7566
SERVICE_ENDPOINT=http://openkb:7566

# ── 平台内部认证（jonex_core，由能力框架读，不是 openkb 引擎读）──
# 必须与 deploy/.env 逐值一致。本容器在 compose 里的 env_file 只有 .env.openkb，
# 镜像里也没有 deploy/.env（.dockerignore 已按安全要求排除），
# 现有环境能跑是**旧镜像里烤过一份 .env** 的历史残余，重建镜像即踩：
#   缺 JWT_SECRET → Sidecar → 本容器 /invoke 一律 403 code=3004（真机实测过同型容器）
#   REDIS_URL 缺 → 服务注册与 30s 心跳失败（不致命，刷日志）
JWT_SECRET=change-me-must-match-platform-deploy-env
JWT_ALGORITHM=HS256
REDIS_URL=redis://redis:6379/0

# ── OpenKB Wiki 存储 ──
OPENKB_KB_ROOT=/app/data/kb_storage

# ── Parsed artifact 输入根目录（路径安全校验用；须与 jonex-rag-inputs 挂载点一致）──
OPENKB_INPUT_ROOT=/app/data/inputs

# ── LLM 配置（走 llm-gateway）──
OPENKB_LLM_BASE_URL=http://llm-gateway:8787/v1
OPENKB_LLM_API_KEY=gw_openkb
# ⚠⚠ 本值与「平台 / JonexWiki / RAG」的模型变量写法**不同**，多一层 provider 前缀。
#
#   原因：openkb 走 LiteLLM（openai-agents 的 LitellmModel），LiteLLM 把 `X/Y`
#   一律当成 `provider/model`，并**剥掉第一段**后才发给上游（llm-gateway）。
#     · 不带前缀 → LiteLLM 直接报 `LLM Provider NOT provided`，请求根本发不出去；
#     · 带前缀   → 上游收到的是**剥掉一层之后**的名字，那个名字必须恰好是上游
#                  真实存在的服务 ID（腾讯 tokenhub 的服务 ID 未必不含斜杠 ——
#                  `deepseek/deepseek-flash` 就是一个自带斜杠的真实服务 ID）。
#
#   所以本值的正确写法 = `provider/` + 上游真实服务 ID：
#     · 本仓库默认服务 ID `deepseek/deepseek-flash`（无斜杠）
#         → 填 `deepseek/deepseek/deepseek-flash`，上游收到 `deepseek/deepseek-flash` ✅
#     · 若某画像沿用自带斜杠的服务 ID `deepseek/deepseek-flash`
#         → 要填 `deepseek/deepseek/deepseek-flash`（**三层，不是笔误**），
#           上游才收到 `deepseek/deepseek-flash` ✅；
#           只写两层会退化成 `deepseek-flash` → 上游 400004「服务 ID 不存在」。
#
#   ⚠ 对比：平台 / JonexWiki / RAG 走 openai SDK、**原样**发模型名，
#     那边（LLM_MODEL / ONTOLOGY_LLM_MODEL / VLM_MODEL_NAME）**不能**带前缀。
#   ⚠ DEFAULT_LLM_MODEL 是"原样发名"口径，**不能**替代本变量 ——
#     本变量必须始终显式设置。
OPENKB_LLM_MODEL=deepseek/deepseek/deepseek-flash

# ── OpenKB 原生解析保留配置（本方案不启用）──
# compile_parsed_document 不读取原始 PDF，不触发 PageIndex。
PAGEINDEX_THRESHOLD=20

# ── Wiki 输出语言 ──
OPENKB_LANGUAGE=zh                   # zh / en

# ── LiteLLM 日志 worker 超时（默认 20s，并发编译高峰时 handler 排队易超时丢日志）──
# 仅影响 LiteLLM 自身 usage/成本日志，不影响编译与计量；调大减少噪音。
LOGGING_WORKER_MAX_TIME_PER_COROUTINE=60
