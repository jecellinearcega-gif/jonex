    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.3",
    "@types/react": "^18.3.0",
    "antd": "^6.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2"
  }
